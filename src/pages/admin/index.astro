---
// Dashboard privado. No aparece en el menú ni en buscadores.
// El acceso real lo protege Supabase (RLS + lista admin_users), no esta página.
import { strings } from '../../i18n/strings';
import '../../styles/admin.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? '';

// Textos editables: clave → [etiqueta, texto por defecto ES, texto por defecto EN]
const pick = (lang: 'es' | 'en') => {
  const t = strings[lang];
  return {
    hero_sub: t.hero.sub,
    details_lede: t.details.lede,
    pide_lede: t.pide.lede,
    radio_lede: t.radio.lede,
    giros_lede: t.giros.lede,
    services_lede: t.services.lede,
    final_lede: t.final.lede,
  };
};
const labels: Record<string, string> = {
  hero_sub: 'Portada · subtítulo',
  details_lede: 'Detalles · introducción',
  pide_lede: 'PideProgreso · descripción',
  radio_lede: 'Radio Emmanuel · descripción',
  giros_lede: 'Giros · introducción',
  services_lede: 'Servicios · introducción',
  final_lede: 'Cierre · invitación',
};
const es = pick('es');
const en = pick('en');
const fields = Object.keys(labels).map((k) => ({ key: k, label: labels[k], es: es[k as keyof typeof es], en: en[k as keyof typeof en] }));
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Panel · DevDesdeCero</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" />
</head>
<body data-sb-url={supabaseUrl} data-sb-key={supabaseKey} data-site={base} data-fields={JSON.stringify(fields)}>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><linearGradient id="lg" x1="0" x2="1" y1="0" y2="1"><stop offset="0" stop-color="#0a66ff"/><stop offset=".55" stop-color="#7b5cff"/><stop offset="1" stop-color="#ff5c8a"/></linearGradient></defs></svg>

<!-- Inicio de sesión -->
<main id="login" class="login" hidden>
  <form id="login-form" class="card login-card" novalidate>
    <svg class="logo" viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="12" rx="7.5" ry="10" fill="none" stroke="url(#lg)" stroke-width="3"/></svg>
    <h1>Panel de DevDesdeCero</h1>
    <p class="muted">Entra con tu cuenta de administrador.</p>
    <label>Correo<input id="l-email" type="email" autocomplete="username" required /></label>
    <label>Contraseña<input id="l-pass" type="password" autocomplete="current-password" required /></label>
    <p id="l-err" class="err" role="alert" hidden></p>
    <button class="btn primary" id="l-btn" type="submit">Entrar</button>
    <button class="link" id="forgot" type="button">¿Olvidaste tu contraseña?</button>
    <a class="back" href={base}>Volver al sitio</a>
  </form>
</main>

<!-- Nueva contraseña (desde el enlace de recuperación) -->
<main id="pw" class="login" hidden>
  <form id="pw-form" class="card login-card" novalidate>
    <h1>Nueva contraseña</h1>
    <label>Contraseña nueva<input id="pw-1" type="password" autocomplete="new-password" minlength="8" required /></label>
    <label>Repítela<input id="pw-2" type="password" autocomplete="new-password" minlength="8" required /></label>
    <p id="pw-err" class="err" role="alert" hidden></p>
    <button class="btn primary" type="submit">Guardar y entrar</button>
  </form>
</main>

<!-- Panel -->
<div id="app" hidden>
  <header class="top">
    <div class="top-in">
      <a class="brand" href={base} title="Ver sitio"><svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="12" rx="7.5" ry="10" fill="none" stroke="url(#lg)" stroke-width="3"/></svg>Panel</a>
      <nav class="tabs" role="tablist" aria-label="Secciones">
        <button role="tab" data-tab="resumen" aria-selected="true">Resumen</button>
        <button role="tab" data-tab="contactos" aria-selected="false">Contactos <span id="badge" class="badge" hidden></span></button>
        <button role="tab" data-tab="textos" aria-selected="false">Textos</button>
        <button role="tab" data-tab="ajustes" aria-selected="false">Correo y redes</button>
      </nav>
      <button class="btn ghost sm" id="logout" type="button">Salir</button>
    </div>
  </header>

  <main class="wrap">
    <p id="g-err" class="err banner" role="alert" hidden></p>

    <!-- Resumen -->
    <section data-panel="resumen">
      <div class="head">
        <h2>Resumen</h2>
        <div class="seg" role="group" aria-label="Periodo">
          <button data-days="7">7 días</button><button data-days="30" class="on">30 días</button><button data-days="90">90 días</button>
        </div>
      </div>
      <div class="kpis" id="kpis"></div>
      <div class="card chart-card">
        <div class="chart-head"><h3>Visitas por día <span class="legend"><i></i>día con contacto</span></h3><button class="link" id="tbl-toggle" type="button">Ver tabla</button></div>
        <div id="chart" class="chart" role="img"></div>
        <div id="chart-tip" class="tip" hidden></div>
        <div id="chart-table" hidden></div>
      </div>
      <div class="grid3">
        <div class="card"><h3>De dónde llegan</h3><ul class="bars" id="sources"></ul></div>
        <div class="card"><h3>Dispositivo</h3><ul class="bars" id="devices"></ul></div>
        <div class="card"><h3>Idioma</h3><ul class="bars" id="langs"></ul></div>
      </div>
      <div class="grid2">
        <div class="card"><div class="chart-head"><h3>Embudo de contactos</h3><button class="link" type="button" data-goto="contactos">Administrar</button></div><p class="muted small" id="pipe-total"></p><ul class="bars" id="pipeline"></ul></div>
        <div class="card"><h3>Navegador</h3><ul class="bars" id="browsers"></ul></div>
      </div>
    </section>

    <!-- Contactos -->
    <section data-panel="contactos" hidden>
      <div class="head">
        <h2>Contactos</h2>
        <div class="filters">
          <input id="q" type="search" placeholder="Buscar nombre, correo o negocio" aria-label="Buscar" />
          <select id="f-status" aria-label="Filtrar por estado">
            <option value="">Todas las etapas</option><option value="nuevo">Nuevo</option><option value="contactado">Contactado</option><option value="calificado">Calificado</option>
            <option value="cotizacion">Cotización</option><option value="negociacion">Negociación</option><option value="ganado">Ganado</option><option value="perdido">No ganado</option>
          </select>
          <button class="btn ghost sm" id="csv" type="button">Exportar CSV</button>
          <button class="btn primary sm" id="add-lead" type="button">Agregar</button>
        </div>
      </div>
      <div id="leads" class="leads"></div>
      <dialog id="new-lead" class="card dialog" aria-labelledby="nl-h">
        <form id="nl-form" class="form" novalidate>
          <h3 id="nl-h">Agregar prospecto</h3>
          <p class="muted small">Para contactos que llegaron por WhatsApp, redes o recomendación.</p>
          <label>Nombre<input name="name" required maxlength="80" /></label>
          <div class="row2"><label>Correo<input name="email" type="email" maxlength="160" /></label><label>Teléfono<input name="phone" type="tel" maxlength="30" /></label></div>
          <label>Negocio<input name="business" maxlength="160" /></label>
          <div class="row2">
            <label>¿Cómo llegó?<select name="source"><option value="whatsapp">WhatsApp</option><option value="facebook">Facebook</option><option value="instagram">Instagram</option><option value="tiktok">TikTok</option><option value="recomendacion">Recomendación</option><option value="cliente">Cliente existente</option><option value="directo">Contacto directo</option><option value="otro">Otro</option></select></label>
            <label>Tipo de proyecto<select name="project_type"><option>Landing page</option><option>Sitio completo</option><option>A medida</option><option>Rediseño</option><option selected>No sé</option></select></label>
          </div>
          <label>¿Qué necesita?<textarea name="message" rows="3" required maxlength="2000"></textarea></label>
          <p id="nl-err" class="err" role="alert" hidden></p>
          <div class="actions"><button class="btn ghost" id="nl-cancel" type="button">Cancelar</button><button class="btn primary" type="submit">Guardar</button></div>
        </form>
      </dialog>
    </section>

    <!-- Textos -->
    <section data-panel="textos" hidden>
      <div class="head">
        <h2>Textos del sitio</h2>
        <div class="seg" role="group" aria-label="Idioma">
          <button data-tlang="es" class="on">Español</button><button data-tlang="en">English</button>
        </div>
      </div>
      <p class="muted note">Deja un campo vacío para usar el texto original. Los cambios se ven en el sitio al recargar.</p>
      <form id="texts" class="card form"></form>
    </section>

    <!-- Ajustes -->
    <section data-panel="ajustes" hidden>
      <div class="head"><h2>Correo y redes</h2></div>
      <form id="settings" class="card form">
        <label>Correo de contacto<input name="contact_email" type="email" required /></label>
        <label>Facebook<input name="facebook_url" type="url" placeholder="https://facebook.com/…" /></label>
        <label>Instagram<input name="instagram_url" type="url" placeholder="https://instagram.com/…" /></label>
        <label>TikTok<input name="tiktok_url" type="url" placeholder="https://tiktok.com/@…" /></label>
        <label>YouTube<input name="youtube_url" type="url" placeholder="https://youtube.com/@…" /></label>
        <label>LinkedIn<input name="linkedin_url" type="url" placeholder="https://linkedin.com/in/…" /></label>
        <div class="actions"><span class="saved" id="s-ok" hidden>Guardado</span><button class="btn primary" type="submit">Guardar</button></div>
      </form>
    </section>
  </main>
</div>

<p id="loading" class="loading">Cargando…</p>

<script>
  import '../../scripts/admin.ts';
</script>
</body>
</html>
